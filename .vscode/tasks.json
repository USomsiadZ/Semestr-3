{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build",
            "command": "/opt/homebrew/bin/python3",
            "type": "process",
            "args": [
                "/Users/hubert/Library/Application Support/Cursor/User/cursor-exercises/run-exercise.py",
                "csharp-build",
                "${file}"
            ],
            "problemMatcher": "$msCompile",
            "presentation": {
                "reveal": "silent",
                "focus": false,
                "panel": "dedicated",
                "showReuseMessage": false,
                "clear": true
            },
            "options": {
                "cwd": "${fileDirname}"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            "label": "publish",
            "command": "/opt/homebrew/bin/python3",
            "type": "process",
            "args": [
                "/Users/hubert/Library/Application Support/Cursor/User/cursor-exercises/run-exercise.py",
                "csharp-publish",
                "${file}"
            ],
            "problemMatcher": "$msCompile",
            "options": {
                "cwd": "${fileDirname}"
            }
        },
        {
            "label": "watch",
            "command": "/opt/homebrew/bin/python3",
            "type": "process",
            "args": [
                "/Users/hubert/Library/Application Support/Cursor/User/cursor-exercises/run-exercise.py",
                "csharp-watch",
                "${file}"
            ],
            "problemMatcher": "$msCompile",
            "options": {
                "cwd": "${fileDirname}"
            }
        }
    ]
}
